{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "note.schema.json",
  "title": "Second Brain note",
  "description": "Front matter for an ordinary Markdown note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "generated",
    "status"
  ],
  "properties": {
    "id": {
      "$ref": "vocabulary.json#/$defs/id"
    },
    "type": {
      "$ref": "vocabulary.json#/$defs/type"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The display title of the note."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "An optional one-line summary."
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "vocabulary.json#/$defs/tag"
      },
      "description": "Optional repository tags."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source.schema.json"
      },
      "description": "Optional external sources referenced by the note."
    },
    "generated": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/generatedEntry"
      },
      "description": "Append-only authorship history."
    },
    "verified": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/verifiedEntry"
      },
      "description": "Append-only human verification history."
    },
    "type_candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "vocabulary.json#/$defs/type"
      },
      "description": "Possible types recorded when Capture is uncertain."
    },
    "status": {
      "$ref": "vocabulary.json#/$defs/status"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "stable"
          }
        }
      },
      "then": {
        "required": [
          "verified"
        ]
      }
    }
  ],
  "$defs": {
    "generatedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "$ref": "vocabulary.json#/$defs/author"
        },
        "at": {
          "$ref": "vocabulary.json#/$defs/dateTime"
        }
      }
    },
    "verifiedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "$ref": "vocabulary.json#/$defs/humanAuthor"
        },
        "at": {
          "$ref": "vocabulary.json#/$defs/dateTime"
        }
      }
    }
  }
}
