#!/bin/sh
set -eu

if command -v brain-validate >/dev/null 2>&1; then
	brain-validate .
elif [ -x _config/.venv/Scripts/brain-validate.exe ]; then
	_config/.venv/Scripts/brain-validate.exe .
elif [ -x _config/.venv/bin/brain-validate ]; then
	_config/.venv/bin/brain-validate .
else
	printf '%s\n' 'brain-validate is not installed; install the project with the Python command for your platform from README.md.' >&2
	exit 1
fi
