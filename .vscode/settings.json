{
  "editor.wrappingIndent": "indent",
  "editor.overviewRulerBorder": false,
  "editor.lineHeight": 24,
  "foam.edit.linkReferenceDefinitions": "withExtensions",
  "foam.files.exclude": [
    "_config/agents-skills/**/*",
    "_config/foam-templates/**/*",
    "_config/generator/**/*",
    "_config/validator/**/*"
  ],
  "emeraldwalk.runonsave": {
    "ignoreUnchangedFiles": false,
    "commands": [
      {
        "match": "^[A-Za-z]:[\\\\/].*_config[\\\\/]schema[\\\\/]vocabulary\\.json$",
        "cmd": "\"${workspaceFolder}/_config/.venv/Scripts/brain-generate-foam.exe\"",
        "autoShowOutputPanel": "error"
      },
      {
        "match": "^/.*_config/schema/vocabulary\\.json$",
        "cmd": "\"${workspaceFolder}/_config/.venv/bin/brain-generate-foam\"",
        "autoShowOutputPanel": "error"
      }
    ]
  },
  "files.exclude": {
    "_site/**": true
  },
  "files.insertFinalNewline": true,
  "markdown.copyFiles.destination": {
    "*": "${documentWorkspaceFolder}/assets/images/${fileName}"
  }
}
